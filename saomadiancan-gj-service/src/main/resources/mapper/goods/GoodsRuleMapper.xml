<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.modules.goods.dao.GoodsRuleMapper">

    <insert id="insertGoodsRule" useGeneratedKeys="true" keyColumn="id" keyProperty="id" parameterType="com.sqx.modules.goods.entity.GoodsRule">
        INSERT INTO goods_rule (create_time, rule_name) values (#{createTime}, #{ruleName})
    </insert>
    <select id="list" resultType="com.sqx.modules.goods.entity.GoodsRule">
        SELECT
            gr.id,
            gr.create_time,
            gr.shop_id,
            gri.rule_name,
            gri.language_type,
            gri.language_name
        FROM
            goods_rule AS gr
        LEFT JOIN goods_rule_i18n AS gri ON gr.id = gri.rule_id
        <where>
            <if test="param.shopId != null">
                and gr.shop_id = #{param.shopId}
            </if>
            <if test="param.ruleName != null and param.ruleName != ''">
                and gr.rule_name like concat('%', #{param.ruleName} ,'%')
            </if>
            <if test="param.languageType != null and param.languageType != ''">
                and gri.language_type = #{param.languageType}
            </if>
        </where>
        order by gr.create_time desc
    </select>


</mapper>