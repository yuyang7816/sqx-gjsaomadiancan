    <update id="updateIschildren">
        update tb_region set ischildren=1 where 1=1
    <if test ='null != id'>
        and region_id=#{id}
    </if>
    </update>

    <update id="updateStatus">
        update tb_region set
            status= #{status}
            where 1=1
        <if test ='null != id'>
            and idtree like #{id}
        </if>
    </update>

    <update id="deleteRegion">
        update tb_region set isdelete =1 where idtree like #{id}
    </update>
</mapper>