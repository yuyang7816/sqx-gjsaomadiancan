<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sqx.modules.languageType.dao.LanguageTypeDao">

    <select id="selectByPage" resultType="com.sqx.modules.languageType.entity.LanguageType">
        select
        id,
        language
        remark,
        is_enable,
        sort,
        create_time,
        update_time
        from
        language_type
        <where>
            1=1
            <if test="language != null and language != ''">
                and language=#{language}
            </if>
            <if test="remark != null and remark != ''">
                and remark=#{remark}
            </if>
        </where>
        order by sort desc
    </select>

    <select id="queryLanguageList" resultType="map">
        select language,remark from language_type where is_enable = 1
    </select>

</mapper>